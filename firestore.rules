rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regla 1: Datos de usuario son privados y solo accesibles por el propio usuario.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas explícitas y seguras para las colecciones de la aplicación.
    // Permiten a cualquier usuario autenticado leer y escribir en ellas.

    match /admins/{docId} {
      allow read, write: if request.auth != null;
    }
    match /executives/{docId} {
      allow read, write: if request.auth != null;
    }
    match /criteria/{docId} {
      allow read, write: if request.auth != null;
    }
    match /nonEvaluableCriteria/{docId} {
      allow read, write: if request.auth != null;
    }
    match /evaluations/{docId} {
      allow read, write: if request.auth != null;
    }
    match /aptitudeSubsections/{docId} {
      allow read, write: if request.auth != null;
    }
    match /evaluationSections/{docId} {
      allow read, write: if request.auth != null;
    }
    match /customTabs/{docId} {
      allow read, write: if request.auth != null;
    }
    match /headerInfo/{docId} {
      allow read, write: if request.auth != null;
    }
    match /executiveFields/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
